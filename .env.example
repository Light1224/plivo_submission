# Plivo credentials — get these from https://console.plivo.com
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Your Plivo phone number (E.164 format)
PLIVO_SOURCE_NUMBER=

# Publicly reachable HTTPS URL for Plivo webhooks (e.g. ngrok)
PUBLIC_BASE_URL=

# Number to forward calls to for Level 2 option 2
LIVE_ASSOCIATE_NUMBER=

# OTP in DDMM format (your birthdate, hardcoded per assignment)
OTP_CODE=

# Default target number pre-filled in UI (optional)
DEFAULT_TARGET_NUMBER=

# Publicly accessible audio file for Level 2 option 1
AUDIO_FILE_URL=https://s3.amazonaws.com/plivocloud/Trumpet.mp3
